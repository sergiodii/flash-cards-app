# -----------------------------------------------------------------------------
# Flash Cards App :: environment variables
#
# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env
#
# Variables prefixed with EXPO_PUBLIC_ are embedded into the client bundle and
# are safe to expose (the Supabase anon key is designed to be public, access is
# controlled by Row Level Security). Never prefix the service_role key.
#
# The SUPABASE_* variables without the prefix are used only by the Supabase CLI
# (link / db push / gen types) and are never shipped to the app.
# -----------------------------------------------------------------------------

# --- App (public) ------------------------------------------------------------
# Hosted project:
#   EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
#   EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key>
#
# Local stack (after `make db.start`, values printed by `make db.status`):
#   EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   EXPO_PUBLIC_SUPABASE_ANON_KEY=<local anon key>
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase CLI (local only, never bundled) --------------------------------
# Get the access token at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Reference id of your hosted project (Supabase dashboard -> Project Settings)
SUPABASE_PROJECT_ID=
# Database password of your hosted project (only needed for remote db push)
SUPABASE_DB_PASSWORD=
# Connection string used by `make db.types`. Defaults to the local database.
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Edge Functions (server-only, never bundled) -----------------------------
# API key used by the `generate-flashcard` function. Pushed to the linked
# project with `make fn.secrets`; never prefix with EXPO_PUBLIC_.
OPENROUTER_API_KEY=
