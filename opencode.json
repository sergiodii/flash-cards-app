{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "external_directory": { "*": "deny" },
    "bash": {
      "*": "ask",

      "pwd*": "allow",

      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git remote*": "allow",
      "git rev-parse*": "allow",
      "git blame*": "allow",

      "node --version*": "allow",
      "yarn --version*": "allow",

      "yarn typecheck*": "allow",
      "yarn lint*": "allow",
      "yarn test*": "allow",

      "make help*": "allow",
      "make validate*": "allow",
      "make typecheck*": "allow",
      "make lint*": "allow",
      "make test*": "allow",
      "make db.status*": "allow"
    }
  }
}